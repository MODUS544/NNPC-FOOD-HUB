// Meal Point - NNPC Limited Workplace Food Ordering Platform
// Prisma Schema Definition for PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  CAFETERIA_VENDOR
  EMPLOYEE
  INTERN
  CONTRACTOR
}

enum VendorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DietaryType {
  VEGETARIAN
  HALAL
  GLUTEN_FREE
  LOW_CARB
  HIGH_PROTEIN
  CONTAINS_NUTS
  SPICY
}

enum CategoryType {
  BREAKFAST
  LUNCH
  LOCAL_NIGERIAN
  CONTINENTAL
  HEALTHY_SALADS
  BEVERAGES
  PASTRIES_SNACKS
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COMPANY_SUBSIDY_WALLET
  PAYROLL_DEDUCTION
  PERSONAL_CARD
}

model User {
  id               String            @id @default(uuid())
  staffId          String            @unique
  email            String            @unique
  fullName         String
  role             UserRole          @default(EMPLOYEE)
  contractorCompany String?         // For CONTRACTOR role
  department       String?
  officeBuilding   String?           // e.g. "NNPC HQ Tower A"
  officeFloor      String?           // e.g. "Floor 7"
  officeDesk       String?           // e.g. "Desk 712"
  avatarUrl        String?
  phoneNumber      String?
  mfaEnabled       Boolean           @default(false)
  wallet           MealWallet?
  orders           FoodOrder[]
  favorites        MealFavorite[]
  managedVendor    CafeteriaVendor?  @relation("VendorAdmin")
  auditLogs        AuditLog[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([staffId])
  @@index([email])
}

model CafeteriaVendor {
  id             String               @id @default(uuid())
  code           String               @unique
  name           String
  location       String
  contactPhone   String
  approvalStatus VendorApprovalStatus @default(APPROVED)
  openingTime    String               @default("07:30")
  closingTime    String               @default("18:00")
  isOperating    Boolean              @default(true)
  adminId        String?              @unique
  admin          User?                @relation("VendorAdmin", fields: [adminId], references: [id])
  menuItems      MenuItem[]
  orders         FoodOrder[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model MenuItem {
  id             String          @id @default(uuid())
  vendorId       String
  vendor         CafeteriaVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name           String
  description    String
  category       CategoryType
  price          Float
  subsidizedPrice Float?
  imageUrl       String?
  isAvailable    Boolean         @default(true)
  stockQuantity  Int             @default(50)
  prepTimeMinutes Int            @default(15)
  calories       Int?
  dietaryTags    DietaryType[]
  orderItems     OrderItem[]
  favorites      MealFavorite[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([vendorId, category])
}

model MealFavorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, menuItemId])
}

model MealWallet {
  id                 String              @id @default(uuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subsidyBalance     Float               @default(15000.0)
  personalBalance    Float               @default(5000.0)
  monthlySubsidyLimit Float              @default(15000.0)
  transactions       WalletTransaction[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model WalletTransaction {
  id             String     @id @default(uuid())
  walletId       String
  wallet         MealWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount         Float
  type           String     // "SUBSIDY_CREDIT" | "MEAL_PURCHASE" | "TOPUP"
  description    String
  referenceNo    String     @unique
  createdAt      DateTime   @default(now())
}

model FoodOrder {
  id                  String          @id @default(uuid())
  orderNumber         String          @unique
  userId              String
  user                User            @relation(fields: [userId], references: [id])
  vendorId            String
  vendor              CafeteriaVendor @relation(fields: [vendorId], references: [id])
  status              OrderStatus     @default(RECEIVED)
  paymentMethod       PaymentMethod   @default(COMPANY_SUBSIDY_WALLET)
  subtotal            Float
  subsidyApplied      Float           @default(0.0)
  totalPaid           Float
  deliveryBuilding    String
  deliveryFloor       String
  deliveryDesk        String
  pickupTimeSlot      String
  specialInstructions String?
  qrPickupCode        String          @unique
  items               OrderItem[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([userId, status])
  @@index([vendorId, status])
}

model OrderItem {
  id         String    @id @default(uuid())
  orderId    String
  order      FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem  @relation(fields: [menuItemId], references: [id])
  quantity   Int       @default(1)
  unitPrice  Float
  totalPrice Float
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  message   String
  priority  String   @default("INFO") // "INFO" | "WARNING" | "URGENT"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  details   String?
  createdAt DateTime @default(now())
}
