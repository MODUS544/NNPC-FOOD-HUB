// NNPC Limited Workplace Services: Food Hub & Cafeteria Database Schema
// Prisma Schema Definition for PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  CAFETERIA_ADMIN
  DEPT_HEAD
  EMPLOYEE
  INTERN
}

enum DietaryType {
  VEGETARIAN
  HALAL
  GLUTEN_FREE
  LOW_CARB
  HIGH_PROTEIN
  CONTAINS_NUTS
  SPICY
}

enum CategoryType {
  BREAKFAST
  LUNCH
  LOCAL_NIGERIAN
  CONTINENTAL
  HEALTHY_SALADS
  BEVERAGES
  PASTRIES_SNACKS
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COMPANY_SUBSIDY_WALLET
  PAYROLL_DEDUCTION
  PERSONAL_CARD
}

enum TransactionType {
  SUBSIDY_CREDIT
  TOPUP_CREDIT
  MEAL_PURCHASE
  REFUND
}

model User {
  id               String              @id @default(uuid())
  staffId          String              @unique
  email            String              @unique
  fullName         String
  role             UserRole            @default(EMPLOYEE)
  departmentId     String?
  department       Department?         @relation(fields: [departmentId], references: [id])
  avatarUrl        String?
  phoneNumber      String?
  wallet           MealWallet?
  orders           FoodOrder[]
  approvedOrders   FoodOrder[]         @relation("ApprovedBySupervisor")
  managedVendors   CafeteriaVendor[]   @relation("VendorAdmin")
  auditLogs        AuditLog[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([staffId])
  @@index([email])
}

model Department {
  id             String      @id @default(uuid())
  name           String      @unique
  code           String      @unique
  headStaffId    String?
  monthlyBudget  Float       @default(500000.0)
  users          User[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model CafeteriaVendor {
  id             String      @id @default(uuid())
  code           String      @unique
  name           String
  location       String
  openingTime    String      @default("07:30")
  closingTime    String      @default("18:00")
  isOperating    Boolean     @default(true)
  adminId        String?
  admin          User?       @relation("VendorAdmin", fields: [adminId], references: [id])
  menuItems      MenuItem[]
  orders         FoodOrder[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model MenuItem {
  id             String        @id @default(uuid())
  vendorId       String
  vendor         CafeteriaVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name           String
  description    String
  category       CategoryType
  price          Float
  subsidizedPrice Float?
  imageUrl       String?
  isAvailable    Boolean       @default(true)
  stockQuantity  Int           @default(50)
  preparationTimeMinutes Int   @default(15)
  calories       Int?
  dietaryTags    DietaryType[]
  orderItems     OrderItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([vendorId, category])
}

model MealWallet {
  id                 String              @id @default(uuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subsidyBalance     Float               @default(15000.0) // Monthly NNPC subsidy in NGN
  personalBalance    Float               @default(5000.0)  // Personal wallet top-up balance
  monthlySubsidyLimit Float              @default(15000.0)
  transactions       WalletTransaction[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model WalletTransaction {
  id             String          @id @default(uuid())
  walletId       String
  wallet         MealWallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount         Float
  type           TransactionType
  description    String
  referenceNo    String          @unique
  createdAt      DateTime        @default(now())
}

model FoodOrder {
  id                String          @id @default(uuid())
  orderNumber       String          @unique
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  vendorId          String
  vendor            CafeteriaVendor @relation(fields: [vendorId], references: [id])
  status            OrderStatus     @default(RECEIVED)
  paymentMethod     PaymentMethod   @default(COMPANY_SUBSIDY_WALLET)
  subtotal          Float
  subsidyApplied    Float           @default(0.0)
  totalPaid         Float
  pickupTimeSlot    String          // e.g. "12:45 PM"
  specialInstructions String?
  qrPickupCode      String          @unique
  supervisorId      String?
  supervisor        User?           @relation("ApprovedBySupervisor", fields: [supervisorId], references: [id])
  items             OrderItem[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId, status])
  @@index([vendorId, status])
}

model OrderItem {
  id             String      @id @default(uuid())
  orderId        String
  order          FoodOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem    @relation(fields: [menuItemId], references: [id])
  quantity       Int         @default(1)
  unitPrice      Float
  totalPrice     Float
}

model AuditLog {
  id             String      @id @default(uuid())
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  action         String
  entity         String
  entityId       String?
  ipAddress      String?
  details        String?
  createdAt      DateTime    @default(now())
}
